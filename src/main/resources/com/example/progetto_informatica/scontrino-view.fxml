<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="400"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.progetto_informatica.ScontrinoController">

    <top>
        <VBox alignment="CENTER" spacing="5">
            <padding>
                <Insets top="20" bottom="10"/>
            </padding>
            <Label text="TEATRO" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="- - - - - - - - - - - - - - - - - -" style="-fx-font-size: 14px;"/>
            <Label text="SCONTRINO" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="- - - - - - - - - - - - - - - - - -" style="-fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets left="30" right="30"/>
            </padding>
            <Label fx:id="labelPosti" style="-fx-font-size: 13px;"/>
            <Label text="- - - - - - - - - - - - - - - - - -" style="-fx-font-size: 14px;"/>
            <Label fx:id="labelTotale" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="labelPagamento" style="-fx-font-size: 14px;"/>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="25" top="20"/>
            </padding>
            <Label text="Grazie per l'acquisto!" style="-fx-font-size: 14px; -fx-font-style: italic;"/>
        </VBox>
    </bottom>

</BorderPane>