<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="400" prefWidth="500"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.progetto_informatica.RiepilogoController">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>
            <Label text="Riepilogo Prenotazione" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets left="30" right="30"/>
            </padding>
            <Label fx:id="labelPosti" style="-fx-font-size: 14px;"/>
            <Label fx:id="labelTotale" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="25" top="20"/>
            </padding>
            <Button text="Paga" prefWidth="200" prefHeight="40"
                    style="-fx-font-size: 16px; -fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
                    onAction="#onPagaClick"/>
        </VBox>
    </bottom>

</BorderPane>